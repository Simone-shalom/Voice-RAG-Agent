# Skopiuj do .env i uzupelnij prawdziwymi wartosciami. Nigdy nie commituj .env.

# Baza danych (Etap 1)
DATABASE_URL=postgresql://voicerag:voicerag@localhost:5433/voicerag

# Transkrypcja - Whisper (Etap 1). Jesli uzywasz OpenAI Whisper API zamiast lokalnego modelu:
OPENAI_API_KEY=

# Synteza mowy - ElevenLabs (Etap 4)
ELEVENLABS_API_KEY=

# Reranking - Cohere (Etap 2, opcjonalnie jesli wybrany zamiast lokalnego cross-encodera)
COHERE_API_KEY=

# LLM dla agenta LangGraph i LLM-as-judge w evalu (Etap 3, Etap 5)
ANTHROPIC_API_KEY=

# CORS - dozwolone originy frontendu, oddzielone przecinkami (Etap 13)
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (Etap 13) - "false" wylacza limity (np. do lokalnych testow)
RATE_LIMIT_ENABLED=true

# Opcjonalny klucz API wymagany w naglowku X-API-Key dla /ingest/* (Etap 13).
# Pozostaw puste, aby nie wymagac klucza (tryb demo/local dev).
API_KEY=
